# ── Server ────────────────────────────────────────────────────────────────
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8000

# ── Admin account ─────────────────────────────────────────────────────────
ADMIN_AUTH_USERNAME=admin
ADMIN_AUTH_PASSWORD=change-me-now
ADMIN_AUTH_DISPLAY_NAME=Remoboard Administrator

# ── Token settings ────────────────────────────────────────────────────────
ADMIN_AUTH_JWT_SECRET=change-this-secret-in-production
ADMIN_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
ADMIN_AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_AUTH_ISSUER=remoboard-cloud-api-admin

# ── Database connection info ──────────────────────────────────────────────
# Keep the database IP address and credentials in .env (never commit to Git)
DB_HOST=192.168.1.10
DB_PORT=5432
DB_NAME=remoboard
DB_USER=remoboard_admin
DB_PASSWORD=please-change-me
# Optional: override all individual DB_* vars with a single URL
# DATABASE_URL=postgresql://remoboard_admin:please-change-me@192.168.1.10:5432/remoboard

# ── Test database ─────────────────────────────────────────────────────────
# Used by: pytest tests/integration/ tests/e2e/
TEST_DATABASE_URL=postgresql://remoboard_test:change-me@192.168.1.10:5432/remoboard_test


